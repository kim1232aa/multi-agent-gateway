@@ -0,0 +1,32 @@
+// apps/kimi-web/src/composables/useDraftAgent.ts
+//
+// 新会话的 Agent 选择(Kimi / Claude / Codex)。multi-agent-gateway 按
+// 会话 id 前缀分流:kimi 无前缀,codex_/claude_ 前缀。这里只影响"新建"
+// 会话 —— 已有会话的 provider 由它的 id 决定,界面切到哪个会话就用哪个。
+// 选择持久化在 localStorage,刷新后保留上次选择。
+
+import { ref } from 'vue';
+import { safeGetString, safeSetString, STORAGE_KEYS } from '../lib/storage';
+
+export type DraftAgent = 'kimi' | 'claude' | 'codex';
+
+function readInitial(): DraftAgent {
+  const raw = safeGetString(STORAGE_KEYS.draftAgent);
+  if (raw === 'claude' || raw === 'codex' || raw === 'kimi') return raw;
+  return 'kimi';
+}
+
+const draftAgent = ref<DraftAgent>(readInitial());
+
+export function useDraftAgent(): {
+  draftAgent: typeof draftAgent;
+  setDraftAgent: (agent: DraftAgent) => void;
+} {
+  return {
+    draftAgent,
+    setDraftAgent(agent: DraftAgent): void {
+      draftAgent.value = agent;
+      safeSetString(STORAGE_KEYS.draftAgent, agent);
+    },
+  };
+}
