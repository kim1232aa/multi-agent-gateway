+// multi-agent-gateway:claude/codex 会话的 `/` 菜单来自网关 /commands 的原生
+// 命令(kind: client 立即本地动作;prompt 留输入框等参数)。
+describe('useSlashMenu — provider commands (multi-agent-gateway)', () => {
+  interface ProviderSetupOpts {
+    provider: 'claude' | 'codex';
+    commands: Array<{ name: string; description: string; kind: 'client' | 'prompt'; acceptsInput?: boolean }>;
+    initialText?: string;
+  }
+
+  function providerSetup({ provider, commands, initialText = '' }: ProviderSetupOpts) {
+    const textarea: MockTextarea = {
+      value: initialText,
+      selectionStart: 0,
+      setSelectionRange(start: number) {
+        this.selectionStart = start;
+      },
+      focus: () => {},
+    };
+    const text = ref(initialText);
+    const textareaRef = ref(textarea as unknown as HTMLTextAreaElement) as Ref<HTMLTextAreaElement | null>;
+    const emitted: string[] = [];
+    const pushed: string[] = [];
+    const commandsRef = ref(commands);
+    const slash = useSlashMenu({
+      text,
+      textareaRef,
+      autosize: () => {},
+      skills: () => [],
+      provider: () => provider,
+      commands: () => commandsRef.value,
+      emitCommand: (cmd) => emitted.push(cmd),
+      historyPush: (entry) => pushed.push(entry),
+    });
+    return { text, textarea, emitted, pushed, slash, commandsRef };
+  }
+
+  it('lists native client + prompt commands, no kimi built-ins', () => {
+    const { slash } = providerSetup({
+      provider: 'claude',
+      initialText: '/',
+      commands: [
+        { name: 'new', description: 'Create a new session', kind: 'client' },
+        { name: 'code-review:code-review', description: 'Code review a pull request', kind: 'prompt' },
+      ],
+    });
+    slash.update();
+    const names = slash.items.value.map((i) => i.name);
+    expect(names).toContain('/new');
+    expect(names).toContain('/code-review:code-review');
+    // kimi 内置命令不得出现在别家会话里
+    expect(names).not.toContain('/goal');
+    expect(names).not.toContain('/swarm');
+  });
+
+  it('drops client commands without a local web implementation (whitelist)', () => {
+    const { slash } = providerSetup({
+      provider: 'codex',
+      initialText: '/',
+      commands: [
+        { name: 'model', description: 'Switch model', kind: 'client' },
+        { name: 'restart', description: 'No local route for this', kind: 'client' },
+      ],
+    });
+    slash.update();
+    const names = slash.items.value.map((i) => i.name);
+    expect(names).toContain('/model');
+    expect(names).not.toContain('/restart');
+  });
+
+  it('prompt-kind commands keep the box open for arguments on select', () => {
+    const { text, emitted, slash } = providerSetup({
+      provider: 'claude',
+      initialText: '/codex:status',
+      commands: [{ name: 'codex:status', description: 'Show status', kind: 'prompt' }],
+    });
+    slash.update();
+    // prompt 型不经菜单 select 提交(走普通文本),但 acceptsInput 语义要保留:
+    // 用户从菜单点选时留在输入框继续补参数,不触发本地 command 事件。
+    const menuItem = slash.items.value.find((i) => i.name === '/codex:status');
+    expect(menuItem?.providerKind).toBe('prompt');
+    expect(menuItem?.acceptsInput).toBe(true);
+    if (menuItem) slash.select(menuItem);
+    expect(text.value).toBe('/codex:status ');
+    expect(emitted).toEqual([]);
