+ * - prompt 命令(如 claude 插件命令)选中后留在输入框,提交时作为消息文本
+ *   发送,由网关展开成真实 prompt。
+ */
+export function buildProviderSlashItems(
+  commands: ReadonlyArray<{
+    name: string;
+    description: string;
+    kind: 'client' | 'prompt';
+    acceptsInput?: boolean;
+  }> = [],
+): SlashCommand[] {
+  // client 型命令由 Web 本地实现(路由在 App.vue 的 command case),目前只有
+  // 这三个;catalog 里其它 client 命令没有本地实现,显示出来选中后只会落
+  // 进默认分支被当成 kimi skill(审查发现),直接不列。
+  const CLIENT_DESC_KEYS: Record<string, string> = {
+    new: 'commands.new.desc',
+    clear: 'commands.clear.desc',
+    model: 'commands.model.desc',
+  };
+  return commands
+    .filter((c) => c.kind === 'prompt' || c.name in CLIENT_DESC_KEYS)
+    .map((c) => {
+    const i18nKey = c.kind === 'client' ? CLIENT_DESC_KEYS[c.name] : undefined;
+    return {
+      name: `/${c.name}`,
+      desc: i18nKey ?? c.description,
+      rawDesc: i18nKey === undefined,
+      providerKind: c.kind,
+      // prompt 命令留在输入框等参数;client 命令立即触发本地动作。
+      acceptsInput: c.kind === 'prompt' ? true : (c.acceptsInput ?? false),
+    };
+  });
+}
