diff --git a/apps/kimi-web/src/lib/sessionProvider.ts b/apps/kimi-web/src/lib/sessionProvider.ts
new file mode 100644
index 0000000..d38e7f7
--- /dev/null
+++ b/apps/kimi-web/src/lib/sessionProvider.ts
@@ -0,0 +1,38 @@
+// multi-agent-gateway:按会话 id 前缀识别提供方。
+// 网关给 Codex/Claude 会话 id 加 codex_/claude_ 前缀;Kimi 会话无前缀(原生 id)。
+import { ref } from 'vue';
+import { safeGetString, safeSetString, STORAGE_KEYS } from './storage';
+
+export type SessionProvider = 'kimi' | 'claude' | 'codex';
+
+export function providerOfSessionId(id: string): SessionProvider {
+  if (id.startsWith('codex_')) return 'codex';
+  if (id.startsWith('claude_')) return 'claude';
+  return 'kimi';
+}
+
+// ---------------------------------------------------------------------------
+// 侧边栏 provider 过滤(全部/Kimi/Claude/Codex)的共享状态。
+// Sidebar 渲染分段控件;useWorkspaceState 在拉取 sessions/workspaces 时带上它
+// (网关 ?provider= → 该 provider 的 top-N,对齐原生 resume 列表),并监听它重载。
+// ---------------------------------------------------------------------------
+export type ProviderFilter = 'all' | SessionProvider;
+
+function loadProviderFilter(): ProviderFilter {
+  const v = safeGetString(STORAGE_KEYS.providerFilter);
+  if (v === 'kimi' || v === 'claude' || v === 'codex') return v;
+  return 'all';
+}
+
+/** 全局唯一实例(模块级 ref,跨 composable 共享)。 */
+export const providerFilter = ref<ProviderFilter>(loadProviderFilter());
+
+export function setProviderFilter(v: ProviderFilter): void {
+  providerFilter.value = v;
+  safeSetString(STORAGE_KEYS.providerFilter, v);
+}
+
+/** 传给网关的 provider 参数;'all' 时不带参数。 */
+export function providerQueryParam(): string | undefined {
+  return providerFilter.value === 'all' ? undefined : providerFilter.value;
+}
