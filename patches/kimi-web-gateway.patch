+    commandsRef.value = [{ name: 'model', description: 'Switch model', kind: 'client' }];
+    await nextTick();
+    expect(text.value).toBe('/');
+    expect(slash.open.value).toBe(true);
+    expect(slash.items.value.map((i) => i.name)).toEqual(['/model']);
